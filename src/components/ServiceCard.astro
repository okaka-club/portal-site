---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const tagColors = [
  'bg-[#ffd6e7] text-pink-700',
  'bg-[#d4f4e2] text-green-700',
  'bg-[#d0eeff] text-blue-700',
  'bg-[#e8d5f5] text-purple-700',
  'bg-[#fff3cd] text-yellow-700',
];
---

<div class="group flex flex-col rounded-2xl bg-white shadow-sm border border-stone-100 overflow-hidden transition hover:shadow-md hover:-translate-y-1">
  <a
    href={service.url}
    target={service.isExternal ? '_blank' : '_self'}
    rel={service.isExternal ? 'noopener noreferrer' : undefined}
    class="flex flex-col flex-1"
  >
    <div class="aspect-video w-full bg-[#fff9f5] flex items-center justify-center overflow-hidden">
      <img
        src={service.thumbnail}
        alt={service.name}
        class="w-full h-full object-cover"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="hidden w-full h-full items-center justify-center text-4xl text-stone-300">
        🎮
      </div>
    </div>

    <div class="p-4 pb-2 flex-1">
      <div class="flex flex-wrap gap-1 mb-2">
        {service.tags.map((tag, i) => (
          <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${tagColors[i % tagColors.length]}`}>
            {tag}
          </span>
        ))}
      </div>
      <h2 class="text-lg font-bold text-stone-800 group-hover:text-pink-600 transition">
        {service.name}
      </h2>
      <p class="mt-1 text-sm text-stone-500 leading-relaxed">
        {service.description}
      </p>
    </div>
  </a>

  {service.detailUrl && (
    <div class="px-4 pb-3">
      <a
        href={service.detailUrl}
        class="text-xs text-stone-400 hover:text-pink-500 transition"
      >
        詳細を見る →
      </a>
    </div>
  )}
</div>
