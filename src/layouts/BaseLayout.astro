---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'おかかくらぶ' } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="おかかくらぶのミニゲーム・診断サービス一覧" />
    <link rel="icon" type="image/png" href="/portal-site/logo.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#fff9f5] font-[Mamelon,sans-serif]">
    <slot />
  </body>
</html>
