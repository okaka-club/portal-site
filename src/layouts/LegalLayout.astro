---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<BaseLayout title={`${title} | おかかくらぶ`}>
  <Header />
  <main class="max-w-4xl mx-auto px-4 py-8 sm:px-6 lg:px-8 font-serif">
    <div class="mb-8">
      <a href="/" class="inline-flex items-center text-sm text-stone-400 hover:text-stone-600 transition">
        ← トップページに戻る
      </a>
      <h1 class="mt-4 text-3xl font-bold text-stone-900">{title}</h1>
    </div>
    <div class="rounded-lg bg-white p-6 shadow-sm sm:p-8">
      <div class="text-sm text-stone-700 leading-relaxed">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
