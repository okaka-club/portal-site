---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';
---

<BaseLayout title="おかかくらぶ">
  <Header />

  <main class="max-w-5xl mx-auto px-4 pb-16">
    <section class="py-10 text-center">
      <h1 class="text-2xl font-bold text-stone-800 mb-3">おかかくらぶへようこそ</h1>
      <p class="text-stone-500 leading-relaxed max-w-xl mx-auto">
        暇つぶしに遊べるミニゲームや診断を作っています。<br />
        友達と一緒に、またはひとりでサクッと楽しめるものを目指しています。
      </p>
    </section>

    <section id="games" class="scroll-mt-6">
      <h2 class="text-sm font-medium text-stone-400 mb-4">コンテンツ一覧</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </section>

    <section class="mt-16 rounded-2xl border border-stone-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-bold text-stone-800">ブラウザで気軽に遊べるものを作っています</h2>
      <div class="mt-4 space-y-3 text-sm leading-relaxed text-stone-600">
        <p>
          おかかくらぶは、ミニゲームや診断サービスを企画・開発している制作チームです。
          インストールなしで始められ、短い時間でも楽しめるコンテンツを中心に公開しています。
        </p>
        <p>
          ひとりでじっくり遊べるゲームから、友達との集まりで使えるゲームまで、
          遊ぶ場面に合わせて選べるサイトを目指しています。
        </p>
      </div>
      <a
        href="/about/"
        class="mt-5 inline-flex text-sm font-medium text-pink-600 transition hover:text-pink-700"
      >
        おかかくらぶについて詳しく見る →
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>
