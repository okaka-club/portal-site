---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';
---

<BaseLayout title="おかかくらぶ">
  <Header />

  <main class="max-w-5xl mx-auto px-4 pb-16">
    <section class="py-10 text-center">
      <h1 class="text-2xl font-bold text-stone-800 mb-3">おかかくらぶへようこそ</h1>
      <p class="text-stone-500 leading-relaxed max-w-xl mx-auto">
        暇つぶしに遊べるミニゲームや診断を作っています。<br />
        友達と一緒に、またはひとりでサクッと楽しめるものを目指しています。
      </p>
    </section>

    <section>
      <h2 class="text-sm font-medium text-stone-400 mb-4">コンテンツ一覧</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
